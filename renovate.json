{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>platform-engineering-org/.github",
    "github>konflux-ci/mintmaker//config/renovate/renovate.json"
  ],
  "ignorePaths": [
    ".tekton"
  ],
  "dependencyDashboard": true,
  "automerge": true,
  "automergeType": "branch",
  "platformAutomerge": true,
  "enabledManagers": [
    "custom.regex"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": [
        "Update 'BUILDER_IMG' in build-args conf files"
      ],
      "managerFilePatterns": [
        "/build-args.*\\.conf$/"
      ],
      "matchStrings": [
        "BUILDER_IMG=(?<depName>.*):(?<currentValue>.*)@(?<currentDigest>.*)\\n"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "/quay.io/centos-bootc/centos-bootc/"
      ],
      "matchFileNames": [
        "build-args-c10s.conf"
      ],
      "groupName": "CentOS Stream 10 bootc updates",
      "groupSlug": "c10s",
      "branchPrefix": "mintmaker/",
      "commitMessageTopic": "CentOS Stream 10 bootc base container image",
      "schedule": [
        "at any time"
      ],
      "recreateWhen": "always",
      "rebaseWhen": "always",
      "ignoreTests": true
    }
  ]
}
