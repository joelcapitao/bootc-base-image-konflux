{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>platform-engineering-org/.github",
    "github>konflux-ci/mintmaker//config/renovate/renovate.json"
  ],
  "ignorePaths": [
    "fedora-coreos-config"
  ],
  "dependencyDashboard": true,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "enabledManagers": [
    "custom.regex"
  ],
  "baseBranchPatterns": [
    "main",
    "rhel-9.6"
  ],
"hostRules": [
    {
      "matchHost": "registry.stage.redhat.io",
      "hostType": "docker",
      "username": "{{secrets.RHEL_REGISTRY_USER}}",
      "password": "{{secrets.RHEL_REGISTRY_PASSWORD}}"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": [
        "Update 'BUILDER_IMG' in build-args conf files"
      ],
      "managerFilePatterns": [
        "/build-args.*\\.conf$/"
      ],
      "matchStrings": [
        "BUILDER_IMG=(?<depName>.*):(?<currentValue>.*)@(?<currentDigest>.*)\\n"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "/quay.io/centos-bootc/centos-bootc/"
      ],
      "matchFileNames": [
        "build-args-c10s.conf"
      ],
      "groupName": "bootc base container images",
      "groupSlug": "bootc-updates",
      "branchPrefix": "mintmaker/",
      "schedule": [
        "at any time"
      ],
      "recreateWhen": "always",
      "rebaseWhen": "always"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "/quay.io/centos-bootc/centos-bootc/"
      ],
      "matchFileNames": [
        "build-args-c9s.conf"
      ],
      "groupName": "bootc base container images",
      "groupSlug": "bootc-updates",
      "branchPrefix": "mintmaker/",
      "schedule": [
        "at any time"
      ],
      "recreateWhen": "always",
      "rebaseWhen": "always"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "/registry.stage.redhat.io/rhel10/rhel10-bootc.*/"
      ],
      "matchFileNames": [
        "build-args-rhel-10.*\\.conf"
      ],
      "groupName": "bootc base container images",
      "groupSlug": "bootc-updates",
      "branchPrefix": "mintmaker/",
      "schedule": [
        "at any time"
      ],
      "recreateWhen": "always",
      "rebaseWhen": "always"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "/registry.stage.redhat.io/rhel9/rhel9-bootc.*/"
      ],
      "matchFileNames": [
        "build-args-rhel-9.*\\.conf"
      ],
      "groupName": "RHEL CoreOS 9 bootc updates",
      "groupSlug": "rhel-9",
      "branchPrefix": "mintmaker/",
      "schedule": [
        "at any time"
      ],
      "recreateWhen": "always",
      "rebaseWhen": "always"
    }
  ]
}
