{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>platform-engineering-org/.github",
    "github>konflux-ci/mintmaker//config/renovate/renovate.json"
  ],
  "ignorePaths": [
    ".tekton"
  ],
  "dependencyDashboard": true,
  "automergeType": "pr",
  "enabledManagers": [
    "custom.regex"
  ],
  "tekton": {
    "additionalBranchPrefix": "",
    "includePaths": [
      ".tekton/**"
    ],
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "baseBranchPatterns": [
    "main"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": [
        "Update 'BUILDER_IMG' in build-args conf files"
      ],
      "managerFilePatterns": [
        "/build-args.*\\.conf$/"
      ],
      "matchStrings": [
        "BUILDER_IMG=(?<depName>.*):(?<currentValue>.*)@(?<currentDigest>.*)\\n"
      ],
      "versioningTemplate": "regex:(?<compatibility>.*)-(?<patch>\\d{8})(\\.n)?\\.(?<build>\\d)",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["/quay.io/centos-bootc/centos-bootc/"],
      "matchFileNames": ["build-args-c10s.conf"],
      "groupName": "CentOS Stream CoreOS 10",
      "groupSlug": "rhel-coreos-config-c10s",
      "branchPrefix": "renovate/c10s/",
      "commitMessageTopic": "CentOS Stream CoreOS 10 bump bootc",
      "schedule": ["at any time"],
      "timezone": "UTC",
      "recreateWhen": "always",
      "rebaseWhen": "always",
      "additionalBranchPrefix": "",
      "automerge": true
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["/quay.io/centos-bootc/centos-bootc/"],
      "matchFileNames": ["build-args-c10s.conf"],
      "groupName": "CentOS Stream CoreOS 10",
      "groupSlug": "rhel-coreos-config-c10s",
      "branchPrefix": "renovate/c10s/",
      "commitMessageTopic": "CentOS Stream CoreOS 10 bump bootc",
      "schedule": ["at any time"],
      "recreateWhen": "always",
      "rebaseWhen": "always",
      "additionalBranchPrefix": "",
      "automerge": true
    }
  ]
}
